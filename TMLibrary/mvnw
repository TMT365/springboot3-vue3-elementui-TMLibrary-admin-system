#!/bin/sh

# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup script (POSIX)
# ----------------------------------------------------------------------------

set -euf
[ "${MVNW_VERBOSE-}" != debug ] || set -x

# OS specific support.
native_path() { printf %s\\n "$1"; }
case "$(uname)" in
CYGWIN* | MINGW*)
  [ -z "${JAVA_HOME-}" ] || JAVA_HOME="$(cygpath --unix "$JAVA_HOME")"
  native_path() { cygpath --path --windows "$1"; }
  ;;
esac

# set JAVACMD and JAVACCMD
set_java_home() {
  if [ -n "${JAVA_HOME-}" ]; then
    if [ -x "$JAVA_HOME/jre/sh/java" ]; then
      JAVACMD="$JAVA_HOME/jre/sh/java"
      JAVACCMD="$JAVA_HOME/jre/sh/javac"
    else
      JAVACMD="$JAVA_HOME/bin/java"
      JAVACCMD="$JAVA_HOME/bin/javac"
      if [ ! -x "$JAVACMD" ] || [ ! -x "$JAVACCMD" ]; then
        echo "The JAVA_HOME environment variable is not defined correctly, so mvnw cannot run." >&2
        echo "JAVA_HOME is set to \"$JAVA_HOME\", but \"\$JAVA_HOME/bin/java\" or \"\$JAVA_HOME/bin/javac\" does not exist." >&2
        return 1
      fi
    fi
  else
    JAVACMD="$(\unset -f command 2>/dev/null; \command -v java)" || :
    JAVACCMD="$(\unset -f command 2>/dev/null; \command -v javac)" || :
    if [ ! -x "${JAVACMD-}" ] || [ ! -x "${JAVACCMD-}" ]; then
      echo "The java/javac command does not exist in PATH nor is JAVA_HOME set." >&2
      return 1
    fi
  fi
}

# hash string like Java String::hashCode
hash_string() {
  str="${1:-}" h=0
  while [ -n "$str" ]; do
    char="${str%"${str#?}"}"
    h=$(((h * 31 + $(printf %d "'$char")) % 4294967296))
    str="${str#?}"
  done
  printf %x\\n $h
}

# resolve script directory
script_dir="$(dirname "$0")"
while [ -h "$0" ]; do
  ls=$(ls -ld "$0")
  link=$(expr "$ls" : '.*-> \(.*\)$')
  if expr "$link" : '/.*' > /dev/null; then
    script_dir="$(dirname "$link")"
  else
    script_dir="$script_dir/$(dirname "$link")"
  fi
done

set_java_home

# locate .mvn/wrapper/maven-wrapper.jar
wrapperJarPath="$script_dir/.mvn/wrapper/maven-wrapper.jar"
wrapperUrl=""
if [ -r "$wrapperJarPath" ]; then
  wrapperUrl="$(native_path "$wrapperJarPath")"
else
  wrapperUrl="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
fi

# locate Maven distribution
distributionUrl=""
distributionUrlName=""
propertiesFile="$script_dir/.mvn/wrapper/maven-wrapper.properties"
if [ -r "$propertiesFile" ]; then
  distributionUrl="$(grep '^distributionUrl=' "$propertiesFile" | cut -d'=' -f2-)"
  distributionUrlName="${distributionUrl##*/}"
fi

# ensure wrapper jar exists locally; download if missing
if [ ! -r "$wrapperJarPath" ]; then
  echo "Downloading Maven Wrapper from $wrapperUrl"
  mkdir -p "$(dirname "$wrapperJarPath")"
  if command -v curl > /dev/null 2>&1; then
    curl -fsSL -o "$wrapperJarPath" "$wrapperUrl"
  elif command -v wget > /dev/null 2>&1; then
    wget -q -O "$wrapperJarPath" "$wrapperUrl"
  else
    echo "Neither curl nor wget is available. Please install one to download the Maven Wrapper." >&2
    exit 1
  fi
fi

exec "$JAVACMD" \
  ${MAVEN_OPTS:-} \
  -classpath "$(native_path "$wrapperJarPath")" \
  "-Dmaven.multiModuleProjectDirectory=$(native_path "$script_dir")" \
  org.apache.maven.wrapper.MavenWrapperMain \
  "$@"