<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.tmt.TMLibrary.mapper.BookCategoryMapper">

    <resultMap id="BookCategoryResultMap" type="com.tmt.TMLibrary.entity.BookCategory">
        <id     property="id"          column="id"/>
        <result property="parentId"    column="parent_id"/>
        <result property="name"        column="name"/>
        <result property="icon"        column="icon"/>
        <result property="sortOrder"   column="sort_order"/>
        <result property="bookCount"   column="book_count"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedTime" column="updated_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, parent_id, name, icon, sort_order, book_count, created_time, updated_time
    </sql>

    <select id="selectAll" resultMap="BookCategoryResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM book_categories
        ORDER BY parent_id, sort_order, id
    </select>

    <select id="selectById" resultMap="BookCategoryResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM book_categories
        WHERE id = #{id}
    </select>

    <select id="selectByParentAndName" resultMap="BookCategoryResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM book_categories
        WHERE parent_id = #{parentId} AND name = #{name}
        LIMIT 1
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO book_categories (parent_id, name, icon, sort_order, book_count)
        VALUES (#{parentId}, #{name}, #{icon}, #{sortOrder}, 0)
    </insert>

    <!-- 原子增减;WHERE 里挡住减成负数的情况(计数漂移时宁可不动,也不要出现 -1) -->
    <update id="adjustBookCount">
        UPDATE book_categories
        SET book_count = book_count + #{delta}
        WHERE id = #{id}
          AND book_count + #{delta} &gt;= 0
    </update>

    <!-- 从 books 重算:分类计数漂移后的修复入口(幂等,可重复执行)
         注意:直接改库绕过了应用层的失效逻辑,缓存里的旧树不会自动更新 ——
         执行完记得 DEL tmlibrary:book:byScope:categories:tree(或等 30 分钟 TTL 自愈) -->
    <update id="recountAll">
        UPDATE book_categories c
        SET c.book_count = (SELECT COUNT(*) FROM books b WHERE b.category_id = c.id)
    </update>

</mapper>
