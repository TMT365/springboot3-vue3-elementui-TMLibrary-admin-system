<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.tmt.TMLibrary.mapper.IpBanMapper">

    <resultMap id="IpBanResultMap" type="com.tmt.TMLibrary.entity.IpBan">
        <id     property="id"         column="id"/>
        <result property="ip"         column="ip"/>
        <result property="reason"     column="reason"/>
        <result property="hitCount"   column="hit_count"/>
        <result property="bannedAt"   column="banned_at"/>
        <result property="expiresAt"  column="expires_at"/>
        <result property="unbannedAt" column="unbanned_at"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, ip, reason, hit_count, banned_at, expires_at, unbanned_at
    </sql>

    <insert id="insertBan" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ip_bans (ip, reason, hit_count, banned_at, expires_at)
        VALUES (#{ip}, #{reason}, #{hitCount}, #{bannedAt}, #{expiresAt})
    </insert>

    <!-- 取最近一条仍生效的封禁:同一 IP 可能有多条历史,按 banned_at 倒序取第一条 -->
    <select id="selectActiveByIp" resultMap="IpBanResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ip_bans
        WHERE ip = #{ip}
          AND unbanned_at IS NULL
          AND expires_at &gt; NOW()
        ORDER BY banned_at DESC
        LIMIT 1
    </select>

    <select id="selectActiveBans" resultMap="IpBanResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ip_bans
        WHERE unbanned_at IS NULL
          AND expires_at &gt; NOW()
        ORDER BY banned_at DESC
    </select>

    <update id="unban">
        UPDATE ip_bans
        SET unbanned_at = NOW()
        WHERE ip = #{ip}
          AND unbanned_at IS NULL
          AND expires_at &gt; NOW()
    </update>

    <delete id="deleteExpiredBefore">
        DELETE FROM ip_bans WHERE expires_at &lt; #{before}
    </delete>

</mapper>
