# TMLibrary 后端本地开发用的环境变量
#
# 用法:
#   1. cp .env.example .env
#   2. 编辑 .env，把 DB_PASSWORD 改成你自己的 MySQL 密码
#   3. ./scripts/dev.sh        # 自动加载 .env 并启动后端
#
# ⚠️  .env 已经被 .gitignore 忽略，绝不要把真实密码 commit 进来
# ⚠️  .env.example 必须是不含敏感信息的模板，提交进 git 给团队复用

# MySQL JDBC 连接串
DB_URL='jdbc:mysql://localhost:3306/tmlibrary?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai'

# MySQL 用户名
DB_USERNAME='root'

# MySQL 密码 —— ⚠️ 把 replace_me 改成真实密码，存到 .env 而不是这里
DB_PASSWORD='replace_me'

# logback 日志配置文件输出路径
LOG_FILE='replace_me'