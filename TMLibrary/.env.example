# TMLibrary 后端本地开发用的环境变量
#
# 用法:
#   1. cp .env.example .env
#   2. 按下面注释填好各项(DB_PASSWORD / JWT_SECRET 必须改)
#   3. ./scripts/dev.sh        # 自动加载 .env 并启动后端
#
# ⚠️  .env 已经被 .gitignore 忽略，绝不要把真实密码 commit 进来
# ⚠️  .env.example 必须是不含敏感信息的模板，提交进 git 给团队复用

# ---------- MySQL ----------
DB_URL='jdbc:mysql://localhost:3306/tmlibrary?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai'
DB_USERNAME='root'
# ⚠️ 改成你自己的 MySQL 密码
DB_PASSWORD='replace_me'

# ---------- Redis ----------
# Redis 6+ ACL:默认用户不填用户名,留空即可
REDIS_USERNAME=''
REDIS_HOST='localhost'
REDIS_PORT='6379'
# 本地 Redis 若未启用密码,留空即可
REDIS_PASSWORD=''

# ---------- JWT ----------
# ⚠️ 必须替换!至少 32 字节。生成方式:
#     openssl rand -base64 48
# ⚠️ 泄露后任何人都能伪造任意用户的 token;轮换会让已签发 token 全部失效
JWT_SECRET='replace_me_with_openssl_rand_base64_48'
# token 有效期(秒),默认 7 天
JWT_EXPIRATION_SECONDS='604800'

# ---------- 日志 ----------
# logback 输出路径。不设置时默认 /opt/logs/tmlibrary.log(需要 root 建目录),
# 本地开发建议改成项目内的相对路径
LOG_FILE='logs/tmlibrary.log'

# ---------- 多实例部署才需要 ----------
# Snowflake 发号器标识,取值 0-31。单实例可保持默认;
# 多实例部署时每个实例必须不同,否则订单号会重复
SNOWFLAKE_WORKER_ID='1'
SNOWFLAKE_DATACENTER_ID='1'
