# ============================================================================
# TMLibrary Docker 部署环境变量 —— 模板
#
# 用法:
#   cp .env.docker.example .env.docker
#   然后改掉所有标了 ★ 的值
#   docker compose --env-file .env.docker up -d --build
#
# ⚠️ .env.docker 必须在 .gitignore 里(本仓库已配好),**不要提交**。
#    这个 .example 文件只放占位符,不放任何真实值。
#
# ⚠️ compose 里对关键项用了 ${VAR:?错误信息} 语法 —— 没设就拒绝启动,
#    报错信息会直接告诉你要设哪个变量。这是有意为之:
#    凭据缺失时"起不来"远好过"起来了但用空密码裸奔"。
# ============================================================================

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# ★ 数据库 root 密码。生产环境请用强密码:
#     openssl rand -base64 24
MYSQL_ROOT_PASSWORD=replace_me

# 库名。改这个的话 DB_URL 里的库名会跟着变(compose 里已联动)
MYSQL_DATABASE=tmlibrary

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# ★ Redis 密码。这个 Redis 存着库存预占状态和 JWT 黑名单,
#   没有密码等于任何人都能改库存、或把登出的 token 从黑名单里恢复
REDIS_PASSWORD=replace_me

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# ★ 签名密钥。泄露 = 任何人都能伪造任意用户的 token(包括 BOSS)。
#   必须至少 48 字节,用:
#     openssl rand -base64 48
JWT_SECRET=replace_me_with_openssl_rand_base64_48

# token 有效期(秒)。默认 7 天
JWT_EXPIRATION_SECONDS=604800

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# ★ 允许访问后端的前端地址。prod profile 里这项**没有默认值**,
#   不配直接启动失败 —— 因为配错了的表现是"页面能开但所有请求跨域失败",
#   比启动失败难排查得多。
#
# 走 compose 里的 nginx 代理时,浏览器眼里只有前端这一个源,
# 同源请求不触发 CORS —— 这里保持和前端地址一致即可。
# 多个域名用逗号分隔,不要有空格:
#   CORS_ORIGINS=https://library.example.com,https://www.library.example.com
CORS_ORIGINS=http://localhost:8081

# ---------------------------------------------------------------------------
# 前端
# ---------------------------------------------------------------------------
# 对外暴露的端口。默认 8081(避开本机开发时的 5173 / 后端 8080)
FRONTEND_PORT=8081

# ---------------------------------------------------------------------------
# Elasticsearch(可选 —— 只有启用 --profile search 时才需要)
# ---------------------------------------------------------------------------
# ★ 启用 search profile 时必须设。不启用就留空
ES_PASSWORD=
ES_USERNAME=elastic
ES_HOSTS=http://elasticsearch:9200

# ---------------------------------------------------------------------------
# IP 风控
# ---------------------------------------------------------------------------
# 可信反向代理的地址列表(逗号分隔)。只有来自这些地址的请求,
# 后端才会采信它带的 X-Forwarded-For 头来识别真实客户端 IP。
#
# ⚠️ 留空 = 不信任任何代理,直接用 TCP 连接的 remoteAddr。
#    这是安全的默认值。**不要**随手填 * 或 0.0.0.0/0 ——
#    那等于让任何人伪造 XFF 头绕过 IP 封禁。
#
# 什么时候要填:后端前面挂了外部 Nginx / 云负载均衡,且需要按真实客户端 IP 限流时。
#   IP_BAN_TRUSTED_PROXIES=172.18.0.0/16,10.0.0.5
IP_BAN_TRUSTED_PROXIES=
